# pnpm configuration
# Hoist nothing by default for stricter, more deterministic dependency trees,
# but allow common build/runtime tools to be hoisted so toolchains resolve them.
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*
save-exact=false
engine-strict=true
