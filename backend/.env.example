# Backend-local environment template. See root .env.example for the full list.
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://fworld:fworld@localhost:5432/fworld?schema=public
REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# Better Auth (cookie sessions). Secret REQUIRED in production (>= 32 chars).
BETTER_AUTH_SECRET=FWorldDevBetterAuthSecret2026!VeryLongKey123
BETTER_AUTH_URL=http://localhost:4000
COOKIE_DOMAIN=
SESSION_ABSOLUTE_MAX_DAYS=30
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_SENSITIVE_MAX=20
# Google OAuth — callback: {BETTER_AUTH_URL}/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_ACCESS_SECRET=FWorldDevJWTAccessSecret2026!VeryLongKey123
JWT_REFRESH_SECRET=FWorldDevJWTRefreshSecret2026!VeryLongKey123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
