// FWorld Prisma schema.
// Milestone 2.1 — Better Auth foundation. Better Auth owns identity:
// User, Session, Account, Verification (auth-architecture/10, Q10).
// Conventions (CTO): snake_case columns/tables via @map/@@map; UUID v7 PKs
// generated at the application layer (newId()); PostgreSQL UUID columns.
// Other domain models are added in later sprints per docs/database-blueprint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core identity (owned by Better Auth, extended by FWorld)
// Prisma field names are camelCase (Better Auth contract); DB columns are
// snake_case via @map. Ids are app-generated UUID v7 stored as native uuid.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @db.Uuid
  name          String?   @db.VarChar(120)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar") // Better Auth `image` ↔ approved `avatar` column
  // FWorld extensions (approved fields)
  role          String    @default("CUSTOMER") @db.VarChar(32)
  status        String    @default("ACTIVE") @db.VarChar(32)
  phone         String?   @db.VarChar(20)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLogin     DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text // credential password lives here, NOT on User
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog — Categories (Milestone 3, first slice). Self-nesting taxonomy.
// Conventions: app-generated UUID v7 PK, snake_case columns via @map,
// timestamptz. Gender/department axis is reserved for a later slice.
// ---------------------------------------------------------------------------

model Category {
  id             String     @id @db.Uuid
  name           String     @db.VarChar(120)
  slug           String     @unique @db.VarChar(140)
  description    String?    @db.Text
  parentId       String?    @map("parent_id") @db.Uuid
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  sortOrder      Int        @default(0) @map("sort_order")
  status         String     @default("ACTIVE") @db.VarChar(16)
  seoTitle       String?    @map("seo_title") @db.VarChar(180)
  seoDescription String?    @map("seo_description") @db.VarChar(320)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([status, sortOrder])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Catalog — Brand, Product, Variant, Image, Inventory (Product Catalog milestone).
// Conventions: app-generated UUID v7 PK, snake_case columns via @map,
// timestamptz, numeric(12,2) money. Stock lives only on Inventory (never on the
// variant). Single-warehouse launch: one Inventory row per variant.
// ---------------------------------------------------------------------------

model Brand {
  id             String   @id @db.Uuid
  name           String   @db.VarChar(120)
  slug           String   @unique @db.VarChar(140)
  logo           String?  @db.Text
  description    String?  @db.Text
  website        String?  @db.VarChar(255)
  status         String   @default("ACTIVE") @db.VarChar(16)
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id               String   @id @db.Uuid
  name             String   @db.VarChar(180)
  slug             String   @unique @db.VarChar(200)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(320)
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  mrp              Decimal  @db.Decimal(12, 2)
  sellingPrice     Decimal  @map("selling_price") @db.Decimal(12, 2)
  status           String   @default("DRAFT") @db.VarChar(16)
  featured         Boolean  @default(false)
  newArrival       Boolean  @default(false) @map("new_arrival")
  bestSeller       Boolean  @default(false) @map("best_seller")
  fit              String?  @db.VarChar(32)
  fabric           String?  @db.VarChar(64)
  sleeveLength     String?  @map("sleeve_length") @db.VarChar(32)
  pattern          String?  @db.VarChar(32)
  neckType         String?  @map("neck_type") @db.VarChar(32)
  occasion         String?  @db.VarChar(32)
  seoTitle         String?  @map("seo_title") @db.VarChar(180)
  seoDescription   String?  @map("seo_description") @db.VarChar(320)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String   @id @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  size          String?  @db.VarChar(24)
  color         String?  @db.VarChar(40)
  colorHex      String?  @map("color_hex") @db.VarChar(9)
  sku           String   @unique @db.VarChar(64)
  barcode       String?  @unique @db.VarChar(64)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductImage[]
  inventory Inventory?

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.Text
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id             String   @id @db.Uuid
  variantId      String   @unique @map("variant_id") @db.Uuid
  availableStock Int      @default(0) @map("available_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  lowStockAlert  Int      @default(0) @map("low_stock_alert")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}
