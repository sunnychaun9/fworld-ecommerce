// FWorld Prisma schema.
// Milestone 2.1 — Better Auth foundation. Better Auth owns identity:
// User, Session, Account, Verification (auth-architecture/10, Q10).
// Conventions (CTO): snake_case columns/tables via @map/@@map; UUID v7 PKs
// generated at the application layer (newId()); PostgreSQL UUID columns.
// Other domain models are added in later sprints per docs/database-blueprint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core identity (owned by Better Auth, extended by FWorld)
// Prisma field names are camelCase (Better Auth contract); DB columns are
// snake_case via @map. Ids are app-generated UUID v7 stored as native uuid.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @db.Uuid
  name          String?   @db.VarChar(120)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar") // Better Auth `image` ↔ approved `avatar` column
  // FWorld extensions (approved fields)
  role          String    @default("CUSTOMER") @db.VarChar(32)
  status        String    @default("ACTIVE") @db.VarChar(32)
  phone         String?   @db.VarChar(20)
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLogin     DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  carts        Cart[]
  orders       Order[]
  addresses      Address[]
  wishlist       Wishlist[]
  couponUsages   CouponUsage[]
  reviews        Review[]
  recentlyViewed RecentlyViewed[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(64)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text // credential password lives here, NOT on User
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Catalog — Categories (Milestone 3, first slice). Self-nesting taxonomy.
// Conventions: app-generated UUID v7 PK, snake_case columns via @map,
// timestamptz. Gender/department axis is reserved for a later slice.
// ---------------------------------------------------------------------------

model Category {
  id             String     @id @db.Uuid
  name           String     @db.VarChar(120)
  slug           String     @unique @db.VarChar(140)
  description    String?    @db.Text
  parentId       String?    @map("parent_id") @db.Uuid
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children       Category[] @relation("CategoryTree")
  products       Product[]
  sortOrder      Int        @default(0) @map("sort_order")
  status         String     @default("ACTIVE") @db.VarChar(16)
  seoTitle       String?    @map("seo_title") @db.VarChar(180)
  seoDescription String?    @map("seo_description") @db.VarChar(320)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([status, sortOrder])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Catalog — Brand, Product, Variant, Image, Inventory (Product Catalog milestone).
// Conventions: app-generated UUID v7 PK, snake_case columns via @map,
// timestamptz, numeric(12,2) money. Stock lives only on Inventory (never on the
// variant). Single-warehouse launch: one Inventory row per variant.
// ---------------------------------------------------------------------------

model Brand {
  id             String   @id @db.Uuid
  name           String   @db.VarChar(120)
  slug           String   @unique @db.VarChar(140)
  logo           String?  @db.Text
  description    String?  @db.Text
  website        String?  @db.VarChar(255)
  status         String   @default("ACTIVE") @db.VarChar(16)
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id               String   @id @db.Uuid
  name             String   @db.VarChar(180)
  slug             String   @unique @db.VarChar(200)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(320)
  categoryId       String   @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  mrp              Decimal  @db.Decimal(12, 2)
  sellingPrice     Decimal  @map("selling_price") @db.Decimal(12, 2)
  status           String   @default("DRAFT") @db.VarChar(16)
  featured         Boolean  @default(false)
  newArrival       Boolean  @default(false) @map("new_arrival")
  bestSeller       Boolean  @default(false) @map("best_seller")
  fit              String?  @db.VarChar(32)
  fabric           String?  @db.VarChar(64)
  sleeveLength     String?  @map("sleeve_length") @db.VarChar(32)
  pattern          String?  @db.VarChar(32)
  neckType         String?  @map("neck_type") @db.VarChar(32)
  occasion         String?  @db.VarChar(32)
  seoTitle         String?  @map("seo_title") @db.VarChar(180)
  seoDescription   String?  @map("seo_description") @db.VarChar(320)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]
  collections    CollectionProduct[]
  wishlist       Wishlist[]
  reviews        Review[]
  recentlyViewed RecentlyViewed[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String   @id @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  size          String?  @db.VarChar(24)
  color         String?  @db.VarChar(40)
  colorHex      String?  @map("color_hex") @db.VarChar(9)
  sku           String   @unique @db.VarChar(64)
  barcode       String?  @unique @db.VarChar(64)
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  inventory        Inventory?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  url       String   @db.Text
  altText   String?  @map("alt_text") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Inventory {
  id             String   @id @db.Uuid
  variantId      String   @unique @map("variant_id") @db.Uuid
  availableStock Int      @default(0) @map("available_stock")
  reservedStock  Int      @default(0) @map("reserved_stock")
  lowStockAlert  Int      @default(0) @map("low_stock_alert")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Catalog — Collections (curated, cross-category merchandising). Deleting a
// collection removes only its join rows; products are untouched.
// ---------------------------------------------------------------------------

model Collection {
  id             String   @id @db.Uuid
  name           String   @db.VarChar(140)
  slug           String   @unique @db.VarChar(160)
  description    String?  @db.Text
  image          String?  @db.Text
  status         String   @default("ACTIVE") @db.VarChar(16)
  sortOrder      Int      @default(0) @map("sort_order")
  seoTitle       String?  @map("seo_title") @db.VarChar(180)
  seoDescription String?  @map("seo_description") @db.VarChar(320)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId, sortOrder])
  @@map("collection_products")
}

// ---------------------------------------------------------------------------
// Cart — one active cart per authenticated user (Milestone 4.1).
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders (Milestone 4.3). Order items snapshot product/variant data and unit
// price so later catalog changes never alter historical orders.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  shippingAddress Json          @map("shipping_address")
  subtotal        Decimal       @db.Decimal(12, 2)
  shipping        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  payments      Payment[]
  shipment      Shipment?
  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  productName  String   @map("product_name") @db.VarChar(180)
  productSlug  String   @map("product_slug") @db.VarChar(200)
  variantSku   String   @map("variant_sku") @db.VarChar(64)
  variantSize  String?  @map("variant_size") @db.VarChar(24)
  variantColor String?  @map("variant_color") @db.VarChar(40)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payments (Milestone 4.4 — Razorpay foundation). No webhooks/capture yet.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  RAZORPAY
}

model Payment {
  id                String          @id @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?         @map("provider_order_id") @db.VarChar(255)
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(255)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR") @db.VarChar(8)
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  failureReason     String?         @map("failure_reason") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Customer profile — Addresses, Wishlist, Coupons (Milestone 4.6–4.8).
// ---------------------------------------------------------------------------

model Address {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(120)
  phone        String   @db.VarChar(20)
  addressLine1 String   @map("address_line1") @db.VarChar(180)
  addressLine2 String?  @map("address_line2") @db.VarChar(180)
  city         String   @db.VarChar(80)
  state        String   @db.VarChar(80)
  postalCode   String   @map("postal_code") @db.VarChar(12)
  country      String   @default("India") @db.VarChar(80)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Wishlist {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id             String     @id @db.Uuid
  code           String     @unique @db.VarChar(40)
  description    String?    @db.Text
  discountType   CouponType @map("discount_type")
  discountValue  Decimal    @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal?   @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?   @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?       @map("usage_limit")
  perUserLimit   Int?       @map("per_user_limit")
  validFrom      DateTime?  @map("valid_from") @db.Timestamptz(6)
  validTo        DateTime?  @map("valid_to") @db.Timestamptz(6)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_usages")
}

// ---------------------------------------------------------------------------
// Reviews & Recently Viewed (Milestone 4.9–4.11). Review aggregates are
// computed in queries (no denormalized columns on Product).
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  rating    Int
  title     String?  @db.VarChar(160)
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model RecentlyViewed {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

// ---------------------------------------------------------------------------
// Operations — Shipment & Order status history (Milestone 5.1–5.3).
// ---------------------------------------------------------------------------

model Shipment {
  id                String    @id @db.Uuid
  orderId           String    @unique @map("order_id") @db.Uuid
  courier           String    @db.VarChar(120)
  trackingNumber    String    @unique @map("tracking_number") @db.VarChar(120)
  trackingUrl       String?   @map("tracking_url") @db.Text
  estimatedDelivery DateTime? @map("estimated_delivery") @db.Timestamptz(6)
  shippedAt         DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipments")
}

model OrderStatusHistory {
  id        String      @id @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?     @db.VarChar(255)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Admin catalog ops — Stock adjustment audit log (Milestone 5.4–5.6).
// adjustedBy holds the admin user id (scalar; no relation to the auth User).
// ---------------------------------------------------------------------------

model StockAdjustment {
  id               String   @id @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  reason           String   @db.VarChar(255)
  previousQuantity Int      @map("previous_quantity")
  newQuantity      Int      @map("new_quantity")
  adjustedBy       String   @map("adjusted_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("adjusted_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("stock_adjustments")
}
