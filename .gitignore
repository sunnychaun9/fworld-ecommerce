# ---------------------------------------------------------------------------
# FWorld — root .gitignore
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Environment & secrets
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# Prisma
backend/prisma/migrations/dev.db*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Vercel / deployment
.vercel/

# Caches
.cache/
.eslintcache
.parcel-cache/
