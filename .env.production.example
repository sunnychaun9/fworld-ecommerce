# FWorld backend — production environment template.
# Copy to `.env.production` and fill in real secrets. NEVER commit the real file.

# Runtime
NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# Database (PostgreSQL) — required in production
DATABASE_URL=postgresql://fworld:CHANGE_ME@postgres:5432/fworld?schema=public
POSTGRES_USER=fworld
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fworld

# Auth (Better Auth) — secret MUST be >= 32 chars and not the dev placeholder
BETTER_AUTH_SECRET=CHANGE_ME_min_32_characters_random_secret
BETTER_AUTH_URL=https://api.fworld.example.com
COOKIE_DOMAIN=.fworld.example.com

# CORS — comma-separated allowed browser origins
CORS_ORIGIN=https://fworld.example.com,https://www.fworld.example.com

# Rate limiting (global)
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

# Google OAuth (optional; both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay (optional; key id + secret both or neither)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis / cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
CACHE_ENABLED=true

# Search & background jobs
SEARCH_PROVIDER=postgres
JOBS_ENABLED=true

# Compose helper
BACKEND_PORT=4000
